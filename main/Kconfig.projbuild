menu "CamTest Configuration"

    choice CAMTEST_WIFI_MODE
        prompt "Wi-Fi 默认模式"
        default CAMTEST_WIFI_MODE_STA
        help
            STA = 连接指定路由器；SoftAP = 板子自开热点（PC 直连）。
            运行时可通过 /api/config 或网页切换，扫描也可遍历两种模式。
        config CAMTEST_WIFI_MODE_STA
            bool "STA（连接路由器）"
        config CAMTEST_WIFI_MODE_AP
            bool "SoftAP（板子开热点）"
    endchoice

    config CAMTEST_WIFI_STA_SSID
        string "STA 模式 SSID"
        default "HUAWEI-DKC"

    config CAMTEST_WIFI_STA_PASSWORD
        string "STA 模式密码"
        default "dkc@2026"

    config CAMTEST_WIFI_AP_SSID
        string "SoftAP SSID"
        default "korvo-s31"

    config CAMTEST_WIFI_AP_PASSWORD
        string "SoftAP 密码（>=8 位，空则开放）"
        default "korvo1234"

    config CAMTEST_MDNS_HOSTNAME
        string "mDNS 主机名"
        default "korvo-s31"

    config CAMTEST_MAX_STREAM_CLIENTS
        int "并发流客户端上限（HTTP+WS 合计）"
        default 4
        range 1 8

    config CAMTEST_ENABLE_UDP
        bool "启用 UDP 分片推送（探索时延下限，需 tools/udp_receiver.py）"
        default y

    config CAMTEST_UDP_PORT
        int "UDP 服务端口"
        default 9100

    config CAMTEST_STREAM_PORT
        int "流服务 TCP 端口（/stream 与 /ws）"
        default 81

    config CAMTEST_SNTP_ON_START
        bool "启动即做 SNTP 对时（提供两端系统钟交叉验证，不用于时延计算）"
        default n

    choice CAMTEST_OV3660_HIFPS
        prompt "OV3660 高帧率档（160x120/240x240 生效；数据驱动自官方 JPEG30fps 时钟树）"
        default CAMTEST_OV3660_HIFPS_L2
        help
            原理：移植 esp_cam_sensor 2.4.x 官方 JPEG30fps 档的时钟树(0x303b/0x303d/0x3824)
            到 YUYV 模式（实测 25→31fps），再中心裁剪垂直读出窗口提帧率。
            代价：垂直视场变小 + 画面纵向拉伸（数字变焦），拉伸倍数见各档说明。
            实测（2026-10-07 本机）：OFF=25fps / L1=31fps / L2=59fps / L3=71fps / L4=87fps。
        config CAMTEST_OV3660_HIFPS_OFF
            bool "关闭（原生 25fps，全视场无拉伸）"
        config CAMTEST_OV3660_HIFPS_L1
            bool "L1: ~31fps（全视场，无拉伸）"
        config CAMTEST_OV3660_HIFPS_L2
            bool "L2: ~59fps（垂直视场 52%，纵向拉伸 ×1.9）"
        config CAMTEST_OV3660_HIFPS_L3
            bool "L3: ~71fps（垂直视场 41%，纵向拉伸 ×2.5）"
        config CAMTEST_OV3660_HIFPS_L4
            bool "L4: ~87fps（垂直视场 33%，纵向拉伸 ×3.1）"
    endchoice

    config CAMTEST_ENABLE_USB
        bool "启用 USB UVC 摄像头采集通路（usb_host_uvc 原生 API，热插拔）"
        default y
        help
            第二条采集通路：USB Host (HS 480 Mbps) + usb_host_uvc 2.5.2。
            走原生 API 而非 esp_video 的 /dev/video40 V4L2 封装（后者断线
            去初始化有资源泄漏缺陷，见 README「可行性结论」）。
            ⚠️ Korvo-1 的 Type-A 座经 TPS2051C 限流 500 mA，推流时建议
            用 Type-C (Power) 口补供电。

    choice CAMTEST_USB_DEFAULT_MODE
        prompt "USB 摄像头默认工作模式"
        default CAMTEST_USB_MODE_PASSTHROUGH
        depends on CAMTEST_ENABLE_USB
        config CAMTEST_USB_MODE_PASSTHROUGH
            bool "passthrough（MJPEG 直通，延迟/CPU 最优；画质由摄像头固件决定）"
        config CAMTEST_USB_MODE_REENCODE
            bool "reencode（YUY2 → 硬件 JPEG，质量可控；带宽压力更大）"
    endchoice

    config CAMTEST_SCAN_WARMUP_MS
        int "扫描每组 warmup 时长 ms"
        default 2000

    config CAMTEST_SCAN_SAMPLE_MS
        int "扫描每组采样时长 ms"
        default 10000

    config CAMTEST_ENABLE_LCD
        bool "启用 LCD 预览与触屏调参（4.3\" 800x480 RGB + GT1151）"
        default y
        help
            上电时先探测 GT1151（I2C 0x14）：未接 LCD 子板则跳过初始化，
            不影响主流程（仅日志告警）。
            接了子板后：右侧参数面板触屏操作与 POST /api/config 完全同
            一条路径（apply 成功才落盘），左侧为实时预览。

    config CAMTEST_LCD_PREVIEW_FPS
        int "LCD 预览解码帧率上限"
        depends on CAMTEST_ENABLE_LCD
        range 0 30
        default 10
        help
            预览解码与 JPEG 编码共用硬件编解码单例（互斥信号量），预览
            解码安排在编码空闲窗口、任务优先级低于采集/编码，但仍占用
            少量编码时间；0 = 不创建解码引擎，编码通路零影响。

endmenu
