# CamTest — ESP32-S31-Korvo-1
# 说明：逐条以 IDF v6.1.0 + esp_video 2.2.0 实际 Kconfig 名称为准（见 docs/API_NOTES.md）。
# 目标锁定（防呆）：显式声明目标芯片
CONFIG_IDF_TARGET="esp32s31"

# ---- Flash / 分区（16MB 模组）----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM（16MB 内置；帧缓冲必须落 PSRAM）----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- 调度 ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- CPU 占用率统计（vTaskGetRunTimeStats，运行时时钟默认用 esp_timer）----
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# ---- esp_video：DVP 摄像头 + 硬件 JPEG 编码器（S31 SOC_JPEG_CODEC_SUPPORTED=1）----
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_HW_JPEG_VIDEO_DEVICE=y
# esp_video 的 USB UVC V4L2 封装保持关闭：USB 走 usb_host_uvc 原生 API（source_usb.c），
# 避免其断线去初始化缺陷与 usb_host_install 冲突（源码侦察结论见 README 可行性一节）
# CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE is not set

# ---- USB UVC（usb_host_uvc 2.5.2，热插拔）----
# 控制传输缓冲：默认 256 字节装不下 UVC 摄像头的配置描述符（UVC 描述符 + 多 alt setting
# 普遍 300~1500 字节），会报 "Configuration descriptor larger than control transfer max
# length" 并导致枚举失败（真机实测 2026-10-07）
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
# 每档离散帧间隔数组长度（部分摄像头列 30/25/20/15/10fps 多档，默认 3 不够）
CONFIG_UVC_INTERVAL_ARRAY_SIZE=6
# 枚举成功时打印完整配置描述符（验收要求：串口可见设备能力清单）
CONFIG_UVC_PRINTF_CONFIGURATION_DESCRIPTOR=y

# ---- 摄像头传感器（运行时自动侦测；两颗都使能，谁在板上用谁）----
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3660_DVP_YUV422_YUYV_640X480_10FPS=y
CONFIG_CAMERA_OV3660_DVP_YUV422_YUYV_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_640X480_10FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_YUV422_YUYV_640X480_10FPS=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_25FPS=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_1280X720_25FPS=y

# ---- HTTP 服务器（浏览器请求头较大；流式响应不被默认头长限制卡住）----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_MAX_URI_HANDLERS=16

# ---- 并发 socket（支持 2~3 个并发观看端 + 流服务）----
CONFIG_LWIP_MAX_SOCKETS=24
# TCP 收发缓冲：默认 5744B 太小——USB 高码率流（640@60≈15Mbps）下发送窗口卡带宽延迟积，
# 到达帧率仅 24fps 且大 JSON 响应会被卡死（真机实测 2026-10-07/08）。48KB 后到达 45fps。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=49152
CONFIG_LWIP_TCP_WND_DEFAULT=49152

# ---- 看门狗：MJPEG 长发送/编码阻塞较久，放宽任务级 WDT 到 10 s（理由见 README）----
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- mDNS ----
CONFIG_MDNS_RESERVE_SEARCH_DOMAIN=n
